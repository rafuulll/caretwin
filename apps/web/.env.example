# =============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE
# =============================================================================
#
# Este arquivo é um MODELO. Ele fica no repositório de propósito, com todos os
# valores vazios, só para você saber quais chaves existem.
#
# COMO USAR
#   1. Faça uma cópia deste arquivo com o nome .env.local
#   2. Preencha só as linhas do que você for usar
#   3. Nunca envie o .env.local para o GitHub (o .gitignore já bloqueia)
#
# O app funciona 100% SEM nenhuma destas chaves. A diferença é que agora o
# código dos dois primeiros blocos JÁ ESTÁ ESCRITO: preencher as linhas e
# reiniciar o servidor liga a funcionalidade, sem programar nada. O roteiro
# completo está em PROXIMOS-PASSOS.md.
#
# REGRA DE OURO: chave é senha. Se você colar uma chave de verdade num arquivo
# que vai para o GitHub, qualquer pessoa pode usar (e você paga a conta).
# Vazou? Apague a chave no painel do serviço e gere outra. Não tem como
# "desvazar".
# =============================================================================


# -----------------------------------------------------------------------------
# LOGIN COM GOOGLE
# -----------------------------------------------------------------------------
# Para quê: deixar a pessoa entrar no app com a conta Google dela, de verdade.
#
# JÁ ESTÁ PRONTO. O fluxo inteiro está escrito em src/lib/google.ts e nas rotas
# de src/app/api/auth. Sem as chaves abaixo, o botão "Continuar com Google"
# abre o tutorial de configuração; com elas, ele faz login de verdade. Você não
# escreve uma linha de código: preenche, reinicia o servidor e pronto.
#
# Onde conseguir: https://console.cloud.google.com/apis/credentials
#   Crie um projeto → Credenciais → Criar credenciais → ID do cliente OAuth →
#   Aplicativo da Web. Em "URIs de redirecionamento autorizados" coloque
#   http://localhost:3000/api/auth/callback/google (e o endereço publicado, se
#   um dia o app for publicado).
#
# O CLIENT_ID pode aparecer no navegador. O CLIENT_SECRET NUNCA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# O segredo que assina a sua sessão. Este não vem do Google: é seu, e pode ser
# qualquer texto embaralhado de 32 caracteres ou mais. No terminal:
#
#   openssl rand -base64 32
#
# Sem ele nenhum login liga, nem o do Google nem o de e-mail e senha (bloco
# abaixo), mesmo com as outras chaves preenchidas. Trocar este valor derruba todo mundo que estava logado, o que é
# exatamente o que você quer fazer se um dia ele vazar.
AUTH_SECRET=


# -----------------------------------------------------------------------------
# CONTAS COM E-MAIL E SENHA (SUPABASE AUTH)
# -----------------------------------------------------------------------------
# Para quê: criar conta, entrar e recuperar a senha de verdade. Quem guarda a
# senha e manda os e-mails de confirmação é o Supabase Auth, no mesmo projeto
# do banco. Precisa também do AUTH_SECRET do bloco acima, que assina a sessão.
#
# JÁ ESTÁ PRONTO. O código está em src/lib/conta.ts e nas rotas de
# src/app/api/auth/conta. Sem as duas linhas abaixo, a tela de entrar continua
# com o formulário simulado de sempre.
#
# Onde conseguir: no painel do Supabase, Project Settings → API Keys.
#   SUPABASE_URL é https://<id-do-projeto>.supabase.co
#   SUPABASE_PUBLISHABLE_KEY é a "Publishable key" (começa com sb_publishable_).
#   A "Secret key" NUNCA entra aqui: ela passa por cima de todas as regras.
#
# No mesmo painel, em Authentication → URL Configuration:
#   Site URL: http://localhost:3000 (o endereço publicado, quando o login for ao ar)
#   Redirect URLs: http://localhost:3000/** (e o endereço publicado com /** no fim)
# Sem isso, os links de confirmação e de nova senha levam para o lugar errado.
#
# Rode também banco/migracoes/0002_usuario_nasce_com_a_conta.sql no SQL Editor:
# é ele que cria a linha em usuarios quando alguém cria a conta.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Para quê: guardar contas, pessoas, pulseiras, dias registrados e alertas no
# banco do Supabase, em vez de no navegador. É o banco da API do CareTwin, que
# mora nas rotas de src/app/api deste mesmo projeto.
#
# JÁ ESTÁ PRONTO. A conexão está em src/lib/banco.ts e as tabelas ficam em
# banco/migracoes/: rode cada arquivo uma vez, em ordem, no SQL Editor do
# Supabase. Sem a linha abaixo, o app mostra os dados de exemplo do navegador;
# com ela, quem entra com e-mail e senha vê só a própria família, pelas rotas
# /api/v1 (as regras de quem vê quem estão em src/lib/familia.ts).
#
# Onde conseguir: no Supabase, crie um projeto (tem plano gratuito), clique em
# "Connect" no topo do painel e copie a connection string do "Transaction
# pooler" (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco e acrescente
# ?sslmode=require no final.
#
# Formato: postgresql://usuario:senha@servidor:6543/postgres?sslmode=require
# Repare que a senha vai dentro da própria URL. Trate a linha inteira como senha.
DATABASE_URL=


# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL
# -----------------------------------------------------------------------------
# Para quê: mandar o resumo do dia por e-mail para quem acompanha.
#
# Onde conseguir: https://resend.com/api-keys, crie a conta, verifique um
# domínio (ou use o domínio de teste deles) e gere uma API key.
#
# A chave começa com "re_".
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Para quê: avisar quem acompanha no WhatsApp quando um alerta novo aparece.
#
# Onde conseguir: https://developers.facebook.com/docs/whatsapp/cloud-api
#   Crie um app no Meta for Developers → adicione o produto WhatsApp → pegue o
#   token de acesso. O token de teste expira em 24 horas; o permanente sai
#   depois da verificação do negócio.
#
# Caminho mais fácil para começar: mandar pelo n8n (bloco abaixo), que já tem
# o conector pronto.
WHATSAPP_TOKEN=


# -----------------------------------------------------------------------------
# N8N (AUTOMAÇÕES)
# -----------------------------------------------------------------------------
# Para quê: o endereço do "gatilho" que o app chama quando algo acontece. O n8n
# recebe esse chamado e dispara a automação que você desenhou na tela dele.
#
# Onde conseguir: suba o n8n com a pasta n8n/ deste projeto (leia n8n/README.md),
# crie um fluxo começando com o nó "Webhook" e copie a URL que ele mostra.
#
# Rodando na sua máquina, costuma ser algo como:
#   http://localhost:5678/webhook/nome-do-seu-fluxo
N8N_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# IA LOCAL QUE EXPLICA OS ALERTAS (OLLAMA)
# -----------------------------------------------------------------------------
# Para quê: o botão "Explicar com a IA" do alerta pede a frase a um modelo que
# roda no seu computador, sem chave e sem custo. O servidor confere a frase
# contra os números do dia (src/lib/ia/verificador.ts) e, se o modelo estiver
# desligado, demorar ou escrever algo errado, mostra o texto de regra no lugar.
#
# JÁ ESTÁ PRONTO. Sem OLLAMA_URL, tudo funciona com o texto de regra.
#
# Como ligar (no computador que vai fazer a demo):
#   1. Instale o Ollama: https://ollama.com/download
#   2. No terminal: ollama pull llama3.2:3b
#   3. Coloque abaixo http://localhost:11434 e reinicie o servidor.
# A versão publicada na Vercel não alcança o seu computador: lá fica o texto de
# regra. Para a demo, rode o site local (npm run dev).
#
# OLLAMA_MODELO: opcional. Modelos maiores escrevem melhor em português
# (por exemplo qwen2.5:7b), se o computador aguentar.
# OLLAMA_TEMPO_MS: opcional. Quanto esperar pelo modelo antes de usar o texto
# de regra. O padrão é 8000 (8 segundos).
OLLAMA_URL=
OLLAMA_MODELO=
OLLAMA_TEMPO_MS=


# -----------------------------------------------------------------------------
# IA QUE ESCREVE OS TEXTOS (OPENAI)
# -----------------------------------------------------------------------------
# Para quê: escrever de verdade o resumo do dia e o texto de cada alerta. Hoje
# esses textos são exemplos montados com os números reais (src/lib/respostas-ia.ts).
#
# O plano do CareTwin é uma IA local (Ollama) chamada pela API do projeto, sem
# chave nenhuma. Esta chave é o caminho alternativo, se o grupo preferir.
#
# Esta é a chave da SUA conta na OpenAI. Ela NUNCA aparece no navegador: a
# chamada sai de uma rota de servidor em src/app/api, e o valor mora só no
# .env.local, que não vai para o repositório.
#
# Onde conseguir: https://platform.openai.com/api-keys
# Formato: começa com "sk-".
OPENAI_API_KEY=
