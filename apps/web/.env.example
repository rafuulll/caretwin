# Variáveis do site CareTwin (apps/web).
# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o Git.
#
# Nesta versão o app funciona sozinho, com dados de exemplo guardados no navegador,
# e não lê nenhuma destas variáveis ainda. Elas estão aqui para quando a API existir.
# Tudo que começa com NEXT_PUBLIC_ fica visível no navegador: nunca coloque segredo aqui.

# URL base da API FastAPI, sem barra no final (contrato em docs/openapi.yaml)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Login com Google pelo Supabase Auth (passo a passo em Como usar, dentro do app)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
